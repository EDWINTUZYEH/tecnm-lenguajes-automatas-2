// La variable queda inicializada porque ambas ramas del if la asignan.
int a;
if (0) {
    a = 1;
} else {
    a = 2;
}
print(a);

int b;
if (1) {
    b = 10;
} else {
    b = 20;
}
print(b);

// if anidado: todas las rutas asignan c.
int c;
if (1) {
    if (1) {
        c = 30;
    } else {
        c = 31;
    }
} else {
    c = 32;
}
print(c);
